# Copy to .env and fill in. Nothing here is required for a local run:
# with no GROQ_API_KEY the judge uses local Ollama, and the harness says so
# in every result row rather than falling back silently.

# --- judge -------------------------------------------------------------
JUDGE_BACKEND=ollama            # groq | ollama | mock   (mock is TEST ONLY)
JUDGE_MODEL=qwen3-vl:2b-instruct
PASS_THRESHOLD=3
GROQ_API_KEY=
GROQ_JUDGE_MODEL=openai/gpt-oss-120b

# --- inference ---------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:2b-instruct

# --- market protocol ---------------------------------------------------
BID_WINDOW_S=2.0
WARM_START_BONUS=0.15
HEARTBEAT_INTERVAL_S=5.0

# --- verification / settlement -----------------------------------------
SAMPLE_RATE=0.05
CHALLENGE_WINDOW_S=3600
MIN_STAKE=10.0
VALIDATOR_SLASH_SHARE=0.80
TREASURY_SLASH_SHARE=0.20
RPC_URL=http://127.0.0.1:8545
